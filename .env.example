# ── Contact enrichment ───────────────────────────────────────────────────────

# Turn contact discovery on at bookmark time. Off unless this is 'true' AND at
# least one provider key below is set (lib/contactDiscovery.ts).
CONTACT_ENRICHMENT_ENABLED=true

# Snov.io credentials — the first email-finder provider in the chain.
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# Comma-separated provider order, e.g. "snov,hunter". Read by
# lib/contactProviders/index.ts; the live discovery path hardcodes its own list,
# so this has no effect today (M-23).
EMAIL_PROVIDER_ORDER=

# Bumping this string invalidates every cached contact lookup (lib/contactCache.ts).
CONTACT_CACHE_VERSION=v2

# ── Supabase (required in production) ─────────────────────────────────────────
# Auth and the source-of-truth Postgres. From the project's API settings page.
# The service-role key bypasses RLS: server-side only, never sent to a browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Durable store (required in production) ────────────────────────────────────

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Background jobs via QStash (required in production) ───────────────────────
# Publishes the outreach email sequence and server-side expert sourcing.
# Without QSTASH_TOKEN, sourcing runs in-process (local dev only — it does not
# survive a server restart). The signing keys verify inbound job callbacks.
# Region-pinned QStash host for this account (publishing to the global host 404s).
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Svix signing secret for the Resend INBOUND email webhook
# (POST /api/inbound-email). Required in production.
RESEND_WEBHOOK_SECRET=

# ── Security ──────────────────────────────────────────────────────────────────

# Random 32+ byte hex string — used to HMAC-pseudonymize all audit log identifiers
# and Redis key names. NEVER log this value. Required in production.
LOG_HASH_SECRET=

# App URL for Origin header validation (required in production)
NEXT_PUBLIC_APP_URL=https://yourapp.com

# Absolute origin used to build links inside outbound emails and job callbacks.
# Optional: falls back to NEXT_PUBLIC_APP_URL, then to https://expertmatch.fit.
NEXT_PUBLIC_BASE_URL=

# 'true' turns on session authentication for the app (lib/auth.ts). Optional.
APP_AUTH_ENABLED=

# Kill switch: 'false' makes every /api/projects route answer 503
# (lib/projectsGuard.ts). Optional; unset means the routes are enabled.
PROJECTS_ENABLED=

# Bearer token that lets a non-session caller through the projects guard
# (lib/projectsGuard.ts). Optional.
PROJECTS_ADMIN_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────────────

# Global daily provider credit budget (default: 500). The cap
# lib/contactDiscovery.ts checks before every provider call (lib/rateLimiter.ts).
ENRICHMENT_DAILY_BUDGET=500

# ── Availability token + scheduling ──────────────────────────────────────────

# HMAC secret for signed availability tokens.
# Generate with: openssl rand -hex 32
# Must be at least 32 hex characters. Required in production.
AVAILABILITY_TOKEN_SECRET=

# HMAC secret for signed signup/invite tokens.
# Generate with: openssl rand -hex 32
# Must be at least 32 hex characters. Required in production.
SIGNUP_TOKEN_SECRET=

# Resend API key for sending availability request emails (required)
# Get yours at https://resend.com
RESEND_API_KEY=

# "From" address for availability request emails (required)
# Format: "Display Name <address@example.com>"
# Domain must be verified in your Resend account.
OUTREACH_FROM_EMAIL="ExpertMatch <outreach@yourdomain.com>"

# Physical postal address rendered in the footer of every expert-facing email,
# alongside the one-click opt-out link. CAN-SPAM requires a valid physical
# address in commercial mail. Optional: when unset, the footer omits the address
# line but still carries the opt-out link.
OUTREACH_POSTAL_ADDRESS="ExpertMatch, 100 Example St, Suite 200, Boston, MA 02110"

# ── Google Calendar OAuth ─────────────────────────────────────────────────────

# OAuth 2.0 credentials from Google Cloud Console. One client serves both flows
# below — register BOTH redirect URIs on it, or the second flow fails with
# redirect_uri_mismatch.
#
#   1. Expert availability link (public, gated by a signed availability token)
#      Redirect URI: https://yourapp.com/api/availability/oauth/google/callback
#      Scopes: https://www.googleapis.com/auth/calendar.freebusy
#
#   2. Client onboarding calendar link (session-authenticated, per user)
#      Redirect URI: https://yourapp.com/api/onboarding/calendar/google/callback
#      Scopes: https://www.googleapis.com/auth/calendar.freebusy openid email
#      ("email" is required so the callback can read which account was linked.)
#
# Both flows sign their OAuth `state` with AVAILABILITY_TOKEN_SECRET and store
# tokens as AES-256-GCM ciphertext using ENCRYPTION_KEY (below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AES-256-GCM key for encrypting OAuth tokens at rest.
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters. Required in production.
ENCRYPTION_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────

# Get from dashboard.stripe.com → Developers → API keys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret from: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Forward these events for the billing flow:
#   Per-call charges (client pays for a completed call):
#     checkout.session.completed, checkout.session.async_payment_failed,
#     payment_intent.succeeded, payment_intent.payment_failed
#   Per-seat subscription (the firm's monthly seat bill — mirrored onto
#   public.organization_billing.subscription_status so the app can warn a firm
#   whose card is failing without calling Stripe):
#     customer.subscription.updated, customer.subscription.deleted,
#     invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# No seat Price id is configured here on purpose. The per-seat Product and its
# volume-tiered monthly Price are created automatically on first use and then
# found by lookup key (SEAT_PRICE_LOOKUP_KEY in lib/pricing.ts, currently
# 'expertmatch_seat_monthly_v1'), so test and live modes each get their own copy
# with no manual dashboard step. A Stripe Price is immutable: changing the seat
# tiers means bumping that lookup key so a new Price is created, leaving existing
# subscriptions on their contracted rate until they are migrated deliberately.

# Publishable key (pk_test_... / pk_live_...) — sent to the browser so the
# onboarding billing step can mount Stripe Elements and confirm the SetupIntent.
# Same dashboard page as STRIPE_SECRET_KEY.
# NOT in validateEnv's REQUIRED_VARS: when it is unset,
# POST /api/onboarding/billing returns 503 billing_unavailable instead of
# failing the production boot. It IS in OPTIONAL_VARS, so the admin env-status
# console reports whether it is set.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Calendar ──────────────────────────────────────────────────────────────────

# Calendly is hidden unless this is EXACTLY 'true'. Calendly's public API answers
# 401 to every unauthenticated call, so a saved booking link produces no slots
# and is indistinguishable from no calendar at all. Left unset (the default),
# the onboarding and settings calendar steps offer only Google Calendar and
# typed weekly hours, POST /api/onboarding/calendar answers
# 400 calendly_disabled for provider 'calendly', and an existing Calendly row
# reads as "not connected" so the user is prompted to link one that works.
# Set it to true only once Calendly is behind a real credential.
CALENDLY_ENABLED=

# ── Zoom Server-to-Server OAuth ───────────────────────────────────────────────

# Create at marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Zoom webhook secret token
# Set in Zoom App → Feature → Event Subscriptions → Secret Token
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── OpenAI ────────────────────────────────────────────────────────────────────

# Get from platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────

# Get from console.anthropic.com/keys
# Used by the expert generation pipeline (generate-experts route)
ANTRHOPICKEYREAL=

# ── Scheduled jobs (cron) ─────────────────────────────────────────────────────

# Bearer secret Vercel Cron sends on every scheduled invocation. Guards
# GET /api/jobs/reconcile and GET /api/jobs/schedule-nudges, which middleware.ts
# does NOT session-authenticate. Both return 503 rather than run when it is
# unset. Generate with: openssl rand -hex 32. Required in production.
CRON_SECRET=

# ── Matchy follow-up nudges ───────────────────────────────────────────────────

# Rephrase each nudge line with one gpt-4o-mini call before sending.
# OFF by default: the built-in lines (lib/nudges.ts) are already one or two
# sentences in the right voice, and a model asked to improve them mostly makes
# them longer. Set to 'true' only to A/B the tone; any output that fails
# lib/matchyBrevity.ts falls straight back to the built-in line.
NUDGE_LLM_VARIATION=false

# Sign-off appended to every outbound expert email, e.g. "Asher" or
# "Asher Goldstein\nExpertMatch". Unset means no sign-off (the CAN-SPAM footer
# already names the sender). Pair it with the display name in
# OUTREACH_FROM_EMAIL so the From: header and the signature agree.
# See lib/senderIdentity.ts.
OUTREACH_SIGNATURE=

# Pin every intro to one trial arm (1 or 2) instead of the per-expert hash
# (lib/matchyTemplates.introArmFor). 1 = the rate in the subject; 2 = "a paid
# call for my client?" in the subject. The body states the hourly rate either
# way. Optional: unset means the deterministic 50/50 split.
INTRO_ARM=

# ── Contact discovery (Hunter) ────────────────────────────────────────────────

# Hunter.io key. lib/contactDiscovery.ts uses it for the company-domain search
# and then as the second email-finder provider after Snov. Optional: without it
# the chain has one fewer provider and reports contact_not_found sooner.
HUNTER_API_KEY=

# ── Outbound email kill switch ────────────────────────────────────────────────

# 'true' suppresses EVERY outbound email, everywhere (the chokepoint in
# lib/emailSequence.ts and each direct Resend caller check it). Optional.
DISABLE_EMAILS=

# Where new-account and access-request notifications go (lib/firmStore.ts).
# Optional: unset means those notifications are not sent.
ADMIN_NOTIFICATION_EMAIL=

# ── Web search behind expert sourcing ─────────────────────────────────────────

# Sourcing needs at least ONE of these keys. With none set the app still boots
# (validateEnv warns) and the first sourcing run fails with no_search_provider.
EXA_API_KEY=
TAVILY_API_KEY=
SCRAPINGBEE_KEY=

# Which of the three to try first ('exa' | 'tavily' | 'scrapingbee'), and
# whether to fall through to the others when it fails. Both optional.
SEARCH_PROVIDER=
SEARCH_FALLBACK_ENABLED=

# Diagnostics only: 'true' runs a second provider alongside the first and logs
# how the two compare (lib/generateExperts.ts). Costs a second call per query.
SEARCH_COMPARE_PROVIDERS=

# Domain for the Reply-To address on every expert-facing email. Its MX record
# points at Resend receiving so replies reach /api/inbound-email. Default:
# reply.expertmatch.fit. Override only for local testing.
OUTREACH_REPLY_DOMAIN=
